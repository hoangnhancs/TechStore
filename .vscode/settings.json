{
  "python.defaultInterpreterPath": "${workspaceFolder}/server/VectorService/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/server/VectorService"
  ],
  "python.envFile": "${workspaceFolder}/server/VectorService/.env",
  "python.terminal.activateEnvironment": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  }
}